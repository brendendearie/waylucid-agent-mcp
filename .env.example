# Optional. Leave unset to use the deterministic mock planner (no paid API).
# WAYLUCID_LLM=mock | openai | anthropic
WAYLUCID_LLM=mock

# Used by the stdio MCP server and the CLI harness.
# viewer | operator | supervisor
WAYLUCID_ROLE=operator

# Required only when WAYLUCID_LLM=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Required only when WAYLUCID_LLM=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
